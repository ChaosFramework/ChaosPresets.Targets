<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Fix paths provided by VisualStudio -->
    <ProjectDir>$(ProjectDir.Replace('\','/'))</ProjectDir>
    <ProjectPath>$(ProjectPath.Replace('\','/'))</ProjectPath>
    <SolutionDir>$(SolutionDir.Replace('\','/'))</SolutionDir>
    <SolutionPath>$(SolutionPath.Replace('\','/'))</SolutionPath>
  </PropertyGroup>
</Project>